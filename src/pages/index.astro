---
import ContactForm from '@/components/ContactForm.astro'
import PackageCard from '@/components/PackageCard.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Portfolio from '@/layouts/Portfolio.astro'
import AstroCover from '@/assets/astro-cover.webp'
import { projects, packages } from '@/lib/constants'
import { Image } from 'astro:assets'
---

<Portfolio>
  <section class="mt-4 mb-6 lg:mb-12 mx-auto 2xl:w-[60%] w-[90%]">
    <h1 class="block">
      <p
        class="leading-normal text-lg md:text-2xl font-semibold tracking-tight text-contrast"
      >
        Hi, I'm Yeremi Rios
      </p>
      <p
        class="text-black dark:text-white leading-[1.1] text-2xl lg:text-3xl font-semibold tracking-tight"
      >
        A Software Developer based in Mexico
      </p>
    </h1>
    <p class="text-sm sm:text-lg md:text-xl mt-2 md:mt-4">
      Technology enthusiast with a strong background in web development. Ready
      to take on a <span class="text-black dark:text-white font-semibold"
        >Full-Stack</span
      > role. Specialized in frontend technologies, with solid backend experience
      using TypeScript, Python, and Go.
    </p>
  </section>
  <section class="bg-secondary border-t">
    <div class="mx-auto 2xl:w-[60%] w-[90%] pt-4">
      <h2
        class="leading-[1.1] text-xl lg:text-3xl font-semibold tracking-tight pt-2 md:pt-4 text-black dark:text-white"
      >
        Things I’ve Built
      </h2>
      <div class="mt-4 grid grid-cols-1 md:grid-cols-[2fr_1fr] gap-4">
        <div class="grid grid-rows-[auto_1fr]">
          <ul class="flex flex-col gap-2">
            {
              projects.map(project => (
                <li>
                  <ProjectCard content={project} />
                </li>
              ))
            }
          </ul>
          <article class="flex items-center justify-center py-6">
            <a
              href="#contact-form"
              class="text-base md:text-lg text-black dark:text-white hover:opacity-60 transition-opacity duration-200"
            >
              Want to collaborate? <span class="text-contrast">Reach out</span>
            </a>
          </article>
        </div>
        <section>
          <h3
            class="leading-[1.1] text-lg lg:text-2xl font-semibold tracking-tight inline-flex gap-2 items-end"
          >
            <img src="/npm.svg" alt="NPM Icon" width="24" height="24" />
            <span class="text-black dark:text-white"> NPM Packages </span>
          </h3>
          <ul class="flex flex-col gap-2 mt-2 max-h-[300px] overflow-y-auto">
            {
              packages.map(project => (
                <li>
                  <PackageCard content={project} />
                </li>
              ))
            }
          </ul>
        </section>
      </div>
      <div class="mt-8 md:mt-14">
        <h2
          class="leading-[1.1] text-xl lg:text-3xl font-semibold tracking-tight"
        >
          About my Tech Stack 📦
        </h2>
        <div
          class="grid grid-cols-1 xl:grid-cols-[1fr_auto] gap-4 md:gap-8 mt-2 md:mt-3"
        >
          <div>
            <p class="md:text-xl text-sm sm:text-lg">
              I have been shipping high-performance web applications using <strong
                >Astro + TailwindCSS</strong
              > as a primary framework. Avoiding the premature use of JavaScript
              frameworks where there is no need for them.
            </p>
            <p class="mt-2 md:text-xl text-sm sm:text-lg">
              Although I have experience with <strong>Vanilla CSS</strong> and solid
              experience with
              <strong>React</strong> (using <strong>Next.js</strong>) and <strong
                >Svelte-Kit</strong
              >. With which I have been able to build a variety of highly
              dynamic web applications.
            </p>
          </div>
          <a
            href="https://astro.build/"
            rel="noopener noreferrer nofollow"
            referrerpolicy="no-referrer"
            target="_blank"
            class="rounded-sm h-fit overflow-hidden hover:opacity-60 transition-opacity duration-200 mx-auto border"
            aria-label="Astro - The web framework for content-driven websites"
          >
            <Image
              src={AstroCover}
              alt="Astro - The web framework for content-driven websites"
              width="500"
              height="300"
              loading="lazy"
              class="w-full xl:w-[300px] h-auto"
            />
          </a>
        </div>
        <p class="mt-4 md:mt-10 md:text-xl text-sm sm:text-lg">
          Outside of the Frontend, I have been working with <strong
            >Node.js</strong
          >, <strong>Bun</strong> and <strong>Python</strong> building from simple
          <strong>APIs (RESTful)</strong>
          to complex <strong>Microservices</strong> and <strong
            >Serverless</strong
          > applications (alongside databases like <strong>PostgreSQL</strong>, <strong
            >MySQL</strong
          > and <strong>SQLite</strong>).
        </p>
      </div>
      <div class="py-6 md:py-12">
        <h2
          class="leading-[1.1] text-xl lg:text-3xl font-semibold tracking-tight text-center bg-primary border py-6 px-2 rounded-sm"
        >
          Not a DevOps but enrolled in DevOps processes ☁️
        </h2>
        <p class="md:text-xl text-sm sm:text-lg mt-4 md:mt-8">
          From the start, I have been handling <strong
            >Infrastructure-related</strong
          >
          tasks. I have experience working with <strong>AWS</strong>, <strong
            >Cloudflare</strong
          > and Containers with <strong>Docker</strong>. I have deep knowledge
          of <strong>Linux</strong> based systems and feel very comfortable using
          <strong>CLI</strong> tools.
        </p>
        <p class="mt-3 md:text-xl text-sm sm:text-lg">
          Code isn't all that matters, having these skills I have been able to
          implement the required changes to achieve the desired outcome.
        </p>
      </div>

      <div>
        <h2
          class="leading-[1.1] text-xl lg:text-3xl font-semibold tracking-tight"
        >
          Lifelong Learner 📚
        </h2>
        <p class="text-sm sm:text-lg md:text-xl mt-2">
          I work primarily with <strong>TypeScript</strong> and <strong
            >Python</strong
          > but I have the basics of other languages like <strong>Rust</strong>, <strong
            >Go</strong
          >, <strong>Lua</strong>, <strong>Java</strong> and <strong>PHP</strong
          >. And I am always looking for new opportunities to learn new
          technologies.
        </p>
      </div>

      <div class="pt-6 md:pt-8 pb-6 md:pb-10">
        <h2
          class="leading-[1.1] text-xl lg:text-3xl font-semibold tracking-tight"
        >
          Let's connect
        </h2>
        <div
          class="grid grid-cols-1 md:grid-cols-[1fr_400px] gap-4 md:gap-4 mt-2 md:mt-3"
        >
          <div>
            <p class="text-sm sm:text-lg md:text-xl">
              You can find me on <a
                href="https://www.linkedin.com/in/yeremi-rrios/"
                rel="noopener noreferrer nofollow"
                referrerpolicy="no-referrer"
                target="_blank"
                class="underline hover:opacity-60 transition-opacity duration-200"
                ><strong>LinkedIn</strong></a
              > and <a
                href="https://github.com/yarso-su"
                rel="noopener noreferrer nofollow"
                referrerpolicy="no-referrer"
                target="_blank"
                class="underline hover:opacity-60 transition-opacity duration-200"
                ><strong>GitHub</strong></a
              > or you can reach me directly through the next contact form. I check
              my emails regularly. I am always happy to hear from you.
            </p>
            <p class="mt-3 md:text-xl text-sm sm:text-lg">
              I always welcome new opportunities to collaborate and learn new
              things 🤓.
            </p>
            <p class="mt-3 md:text-xl text-sm sm:text-lg">
              Cheers, <br />Yarso
            </p>
          </div>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Portfolio>
