---
import type { Project } from '@/lib/constants'
import Link from '@lucide/astro/icons/square-arrow-out-up-right'

interface Props {
  content: Project
  horizontal?: boolean
}

const { content, horizontal = false } = Astro.props
---

<article
  class={`rounded-sm border p-3 bg-primary ${horizontal ? 'h-full' : ''}`}
>
  <h3>
    <a
      href={content.link}
      target="_blank"
      referrerpolicy="no-referrer"
      rel="noopener noreferrer nofollow"
      class="hover:underline underline-offset-2 inline-flex items-center gap-1"
    >
      <span class="text-sm sm:text-base text-black">
        {content.title}
      </span>
      <Link class="size-3" />
    </a>
  </h3>
  <p class="text-xs sm:text-sm">
    {content.description}
  </p>
</article>
