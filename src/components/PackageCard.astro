---
import { cn } from '@lib/utils'
import Link from '@lucide/astro/icons/square-arrow-out-up-right'
import type { Project } from '@lib/types'

interface Props {
  content: Project
  horizontal?: boolean
}

const { content, horizontal = false } = Astro.props
---

<article
  class={cn('rounded-sm border p-3 bg-primary', horizontal ? 'h-full' : '')}
>
  <h3>
    <a
      href={content.link}
      target="_blank"
      referrerpolicy="no-referrer"
      rel="noopener noreferrer nofollow"
      class="inline-flex items-center gap-1 underline-offset-2 hover:underline"
    >
      <span class="text-sm text-black sm:text-base">
        {content.title}
      </span>
      <Link class="size-3" />
    </a>
  </h3>
  <p class="text-xs sm:text-sm">
    {content.description}
  </p>
</article>
