---
import type { Project } from '@/lib/constants'
import Link from '@lucide/astro/icons/square-arrow-out-up-right'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import BlogImage from '@/assets/es-blog-cover.webp'
import JollaadminImage from '@/assets/jollaadmin-cover.webp'
import GithubImage from '@/assets/github.webp'

const images: Record<string, ImageMetadata> = {
  blog: BlogImage,
  jollaadmin: JollaadminImage,
  github: GithubImage
}

interface Props {
  content: Project
}

const { content } = Astro.props
---

<article
  class="rounded-sm border bg-primary grid grid-cols-[1fr_auto] overflow-hidden"
>
  <div class="p-3">
    <h3>
      <a
        href={content.link}
        target="_blank"
        referrerpolicy="no-referrer"
        rel="noopener noreferrer nofollow"
        class="hover:underline underline-offset-2 inline-flex items-center gap-1"
      >
        <span class="text-sm sm:text-lg md:text-xl text-black">
          {content.title}
        </span>
        <Link class="size-3 md:size-4" />
      </a>
    </h3>
    <p class="mt-1 text-sm sm:text-base line-clamp-2 sm:line-clamp-none">
      {content.description}
    </p>
  </div>
  {
    content.imageKey && (
      <Image
        src={images[content.imageKey]}
        alt={content.title}
        loading="lazy"
        width={100}
        class="border-l w-full h-auto aspect-square object-cover"
      />
    )
  }
</article>
