---
import Link from '@lucide/astro/icons/square-arrow-out-up-right'

interface Props {
  content: {
    title: string
    tag: string
    description: string
    link: string
    type: 'package' | 'website' | 'private'
  }
}

const { content } = Astro.props
const { type = 'website' } = content
---

<article class="rounded-sm border-[1px] p-3 bg-primary">
  <h3>
    <a
      href={content.link}
      target="_blank"
      referrerpolicy="no-referrer"
      rel="noopener noreferrer nofollow"
      class="hover:underline underline-offset-2 inline-flex items-center gap-1"
    >
      <span class="sm:text-lg md:text-xl text-black dark:text-white">
        {content.title}
      </span>
      <Link class="size-3 md:size-4" />
    </a>
  </h3>
  <p class="inline-flex items-center gap-[5px] opacity-90">
    {
      type === 'website' && (
        <span class="bg-contrast w-[8px] h-[12px] rounded-[2px]" />
      )
    }
    {
      type === 'package' && (
        <span class="bg-amber-500 w-[8px] h-[12px] rounded-[2px]" />
      )
    }
    {
      type === 'private' && (
        <span class="bg-purple-500 w-[8px] h-[12px] rounded-[2px]" />
      )
    }
    <span class="text-sm sm:text-base">
      {content.tag}
    </span>
  </p>
  <p class="mt-1 md:mt-2 text-sm sm:text-base">
    {content.description}
  </p>
</article>
