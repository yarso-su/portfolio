---
import type { Project } from '@lib/types'
import Link from '@lucide/astro/icons/square-arrow-out-up-right'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import BlogImage from '@assets/es-blog-cover.webp'
import JollaadminImage from '@assets/jollaadmin-cover.webp'
import GithubImage from '@assets/github.webp'

const images: Record<string, ImageMetadata> = {
  blog: BlogImage,
  jollaadmin: JollaadminImage,
  github: GithubImage
}

interface Props {
  content: Project
}

const { content } = Astro.props
---

<li
  class="bg-primary m-0 grid grid-cols-[1fr_auto] overflow-hidden rounded-sm border p-0"
>
  <div class="p-3">
    <h3>
      <a
        href={content.link}
        target="_blank"
        referrerpolicy="no-referrer"
        rel="noopener noreferrer nofollow"
        class="inline-flex items-center gap-1 underline-offset-2 hover:underline"
      >
        <span class="text-sm text-black sm:text-lg md:text-xl">
          {content.title}
        </span>
        <Link class="size-3 md:size-4" />
      </a>
    </h3>
    <p class="mt-1 line-clamp-2 text-sm sm:line-clamp-none sm:text-base">
      {content.description}
    </p>
  </div>
  {
    content.imageKey && (
      <Image
        src={images[content.imageKey]}
        alt={content.title}
        loading="lazy"
        width={100}
        class="aspect-square h-full w-auto border-l object-cover"
      />
    )
  }
</li>
