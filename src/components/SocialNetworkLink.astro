---
import Link from '@lucide/astro/icons/square-arrow-out-up-right'

interface Props {
  link: string
  text: string
}

const { link, text } = Astro.props
---

<a
  href={link}
  target="_blank"
  referrerpolicy="no-referrer"
  rel="noopener noreferrer nofollow"
  class="bg-primary inline-flex w-full items-center gap-1 rounded-sm border p-3 underline-offset-2 hover:underline"
>
  <span class="text-sm text-black sm:text-base">
    {text}
  </span>
  <Link class="size-3" />
</a>
