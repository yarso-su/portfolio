---
import ContactForm from '@components/ContactForm.astro'
---

<section class="mx-auto mt-12 w-[90%] 2xl:w-[60%]">
  <h2 class="text-xl md:text-3xl">🧑‍💻 You reached the end</h2>
  <div class="mt-3 grid grid-cols-1 gap-4 lg:grid-cols-[1fr_2fr]">
    <ContactForm />
    <div>
      <p>
        If you found something interesting, have a question, want to talk about
        code, books, or just say hello, feel free to send me a message.<br /><br
        /> I check my inbox regularly (probably while drinking coffee and reading
        someone else’s code).
      </p>
      <p class="mt-4">
        Cheers, <br />Alesandro.
      </p>
    </div>
  </div>
</section>
