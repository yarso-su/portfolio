---
import ContactForm from '@components/ContactForm.astro'
---

<section class="mx-auto mt-12 w-[90%] sm:mt-18 2xl:w-[60%]">
  <h2
    class="mt-10 scroll-m-20 pb-2 text-3xl font-semibold tracking-tight transition-colors first:mt-0"
  >
    Let's connect
  </h2>
  <div class="mt-2 grid grid-cols-1 gap-4 lg:grid-cols-[1fr_2fr]">
    <ContactForm />
    <div>
      <p class="text-sm sm:text-lg md:text-xl">
        You can find me on <a
          href="https://www.linkedin.com/in/yeremi-rrios/"
          rel="noopener noreferrer nofollow"
          referrerpolicy="no-referrer"
          target="_blank"
          class="underline transition-opacity duration-200 hover:opacity-60"
          ><strong>LinkedIn</strong></a
        > and <a
          href="https://github.com/yarso-su"
          rel="noopener noreferrer nofollow"
          referrerpolicy="no-referrer"
          target="_blank"
          class="underline transition-opacity duration-200 hover:opacity-60"
          ><strong>GitHub</strong></a
        >, or reach me directly through the contact form. I check my emails
        regularly and I'm always happy to hear from you.
      </p>
      <p class="mt-4 text-sm sm:text-lg md:text-xl">
        Cheers, <br />Yeremi R.
      </p>
    </div>
  </div>
</section>
