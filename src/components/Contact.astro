---
import ContactForm from '@components/ContactForm.astro'
---

<section class="mx-auto mt-10 w-[90%] sm:mt-14 2xl:w-[60%]">
  <h2
    class="mb-3 scroll-m-20 text-3xl font-semibold tracking-tight transition-colors"
  >
    🧑‍💻 You reached the end
  </h2>
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-[1fr_2fr]">
    <ContactForm />
    <div>
      <p class="text-sm sm:text-lg md:text-xl">
        If you found something interesting, have a question, want to talk about
        code, books, or just say hello, feel free to send me a message.<br /><br
        /> I check my inbox regularly (probably while drinking coffee and reading
        someone else’s code).
      </p>
      <p class="mt-4 text-sm sm:text-lg md:text-xl">
        Cheers, <br />Alesandro.
      </p>
    </div>
  </div>
</section>
