---
import ContactForm from '@/components/ContactForm.astro'
---

<section class="mt-12 sm:mt-18 mx-auto 2xl:w-[60%] w-[90%]">
  <h2
    class="leading-[1.1] text-xl sm:text-2xl lg:text-3xl font-semibold tracking-tight"
  >
    Let's connect
  </h2>
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] mt-3 gap-4">
    <ContactForm />
    <div>
      <p class="text-sm sm:text-lg md:text-xl">
        You can find me on <a
          href="https://www.linkedin.com/in/yeremi-rrios/"
          rel="noopener noreferrer nofollow"
          referrerpolicy="no-referrer"
          target="_blank"
          class="underline hover:opacity-60 transition-opacity duration-200"
          ><strong>LinkedIn</strong></a
        > and <a
          href="https://github.com/yarso-su"
          rel="noopener noreferrer nofollow"
          referrerpolicy="no-referrer"
          target="_blank"
          class="underline hover:opacity-60 transition-opacity duration-200"
          ><strong>GitHub</strong></a
        >, or reach me directly through the contact form. I check my emails
        regularly and I'm always happy to hear from you.
      </p>
      <p class="mt-4 md:text-xl text-sm sm:text-lg">
        Cheers, <br />Yeremi Ríos
      </p>
    </div>
  </div>
</section>
