---
import { cn } from '@lib/utils'

type Props = astroHTML.JSX.ButtonHTMLAttributes

const { class: className, ...props }: Props = Astro.props
---

<button
  class={cn(
    className,
    'border p-2 rounded-sm outline-0 hover:outline-2 transition-[outline-width] duration-75 bg-secondary'
  )}
  {...props}
>
  <slot />
</button>
