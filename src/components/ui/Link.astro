---
import { cn } from '@lib/utils'

type Props = astroHTML.JSX.AnchorHTMLAttributes

const { class: className, ...props }: Props = Astro.props
---

<a
  class={cn(
    className,
    'border p-2 rounded-sm bg-secondary hover:bg-primary transition-colors duration-200'
  )}
  {...props}
>
  <slot />
</a>
